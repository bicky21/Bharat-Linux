#!/bin/sh

TARGET="/mnt"

echo "================================="
echo " Bharat-linux Installer "
echo "================================="

echo ""
echo "Available disks:"
fdisk -l

echo ""
echo "WARNING: This will erase target disk."
echo ""

echo -n "Enter target disk (example: /dev/sdb): "
read DISK

echo ""
echo "Creating partition table..."

echo "o
n
p
1


w" | fdisk $DISK

PARTITION="${DISK}1"

echo ""
echo "Formatting partition..."

mkfs.ext4 $PARTITION

mkdir -p $TARGET

echo ""
echo "Mounting target..."

mount $PARTITION $TARGET

echo ""
echo "Copying Bharat-linux filesystem..."

cp -a /bin $TARGET/
cp -a /sbin $TARGET/
cp -a /etc $TARGET/
cp -a /usr $TARGET/
cp -a /root $TARGET/
cp -a /home $TARGET/
cp -a /var $TARGET/

mkdir -p $TARGET/proc
mkdir -p $TARGET/sys
mkdir -p $TARGET/dev

echo ""
echo "Installation complete."
echo ""
echo "You now need to install GRUB manually."
