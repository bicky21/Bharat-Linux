#!/bin/sh

SERVICE=$1
ACTION=$2

SCRIPT="/etc/services/available/$SERVICE"

if [ ! -f "$SCRIPT" ]; then
    echo "Service not found"
    exit 1
fi

case "$ACTION" in
    start)
        sh $SCRIPT start
        ;;
    stop)
        sh $SCRIPT stop
        ;;
    restart)
        sh $SCRIPT stop
        sh $SCRIPT start
        ;;
    status)
        sh $SCRIPT status
        ;;
    *)
        echo "Usage: service <name> {start|stop|restart|status}"
        ;;
esac
