#!/bin/sh

REPO="/packages/repo"

case "$1" in

list)
    cat $REPO/index
    ;;

install)
    PACKAGE=$2

    ENTRY=$(grep "^$PACKAGE|" $REPO/index)

    FILE=$(echo $ENTRY | cut -d'|' -f3)

    cp $REPO/$FILE /tmp/

    cd /tmp

    tar -xzf $FILE

    cp -r * /

    echo "Installed $PACKAGE"
    ;;

*)
    echo "Usage:"
    echo "  bpk list"
    echo "  bpk install <package>"
    ;;
esac
