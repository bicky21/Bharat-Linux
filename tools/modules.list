# Drivers copied into Bharat-linux by tools/copy-modules.sh
# mouse, and the USB tablet QEMU uses as a mouse
psmouse
hid
usbhid
hid_generic
# network cards that QEMU can emulate
8139too
8139cp
e1000
virtio_net
# USB sticks and disks
xhci_pci
usb_storage
uas
# file systems found on USB sticks and CDs
isofs
exfat
ntfs3
nls_utf8
nls_iso8859-1
# compressed memory used as swap
zram
zstd
# disks a system can be installed on (loaded by the bootstrap at start)
ahci
nvme
mmc_block
sdhci_pci
# wired network cards: VMs (QEMU, VirtualBox, VMware) and common PCs
e1000
e1000e
igb
r8169
pcnet32
vmxnet3
tg3
alx
atl1c
# phones sharing their internet over USB (tethering)
usbnet
cdc_ether
rndis_host
cdc_ncm
