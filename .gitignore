# --- things that are built, not written ---
# Programs compiled by `make` (source lives in src/)
/rootfs/init
/rootfs/bin/*
!/rootfs/bin/.keep

# Kernel modules copied from the host by `make modules`
/rootfs/lib/modules/

# Disk images and initramfs
/images/*
!/images/.keep
mnt/

# Compiler leftovers
a.out
*.o

# Files the running system creates
/rootfs/home/*/.history


# Downloaded and built by tools/third-party.sh
/build/
/rootfs/usr/share/licenses/
/rootfs/etc/ssl/certs/ca-certificates.crt

# The Tor pack, made by tools/torbrowser.sh (make torbrowser)
/rootfs/opt/
/rootfs/lib/x86_64-linux-gnu/
/rootfs/lib64/
/rootfs/usr/lib/
/rootfs/usr/bin/
/rootfs/usr/share/X11/
/rootfs/usr/share/icons/
/rootfs/usr/share/glib-2.0/
/rootfs/var/lib/xkb/
/rootfs/etc/nsswitch.conf
/rootfs/usr/local/
/rootfs/usr/share/mime/
